---
import BaseLayout from "../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const installCmd = "curl -fsSL https://not-the-ccp.github.io/avelune/install.sh | sh";
const scriptUrl = "https://github.com/not-the-ccp/avelune/blob/main/scripts/install.sh";
---

<BaseLayout
  mode="grid"
  current="home"
  description="Avelune is an experimental audio/video codec and indexed streaming container written in Rust."
>
  <div class="home-shell">
    <section class="hero" aria-labelledby="hero-title">
      <h1 id="hero-title">Avelune</h1>
      <p class="hero-summary">An experimental audio/video codec and indexed streaming container written in Rust.</p>
      <p class="hero-status">Draft Generation 1 is under active development. Bitstreams, APIs, and decoded semantics may change incompatibly while the project is 0.x.</p>
      <div class="hero-actions">
        <a class="button-link" href={`${base}/demo/`}>Try the demo</a>
        <a class="text-link" href={`${base}/docs/`}>Documentation</a>
        <a class="text-link" href={`${base}/spec/`}>Specification</a>
      </div>
    </section>

    <section class="start" aria-labelledby="start-title">
      <h2 id="start-title">What you can use now</h2>
      <div class="start-grid">
        <a href={`${base}/demo/`}>
          <strong>Browser demo</strong>
          <span>Play <code>.avl</code> files or convert ordinary video to Avelune in the browser.</span>
        </a>
        <a href={`${base}/docs/cli/`}>
          <strong>Command-line tools</strong>
          <span>Encode, decode, inspect, verify, repair, and reindex Avelune media.</span>
        </a>
        <a href={`${base}/spec/`}>
          <strong>Format specification</strong>
          <span>Read the current Draft Generation 1 video, audio, container, entropy, and conformance definitions.</span>
        </a>
      </div>
    </section>

    <section class="install" aria-labelledby="install-title">
      <div class="section-copy">
        <h2 id="install-title">Install the CLI</h2>
        <p>The installer clones the repository and builds the CLI from source with the pinned Rust toolchain. Ordinary media input and output also requires FFmpeg.</p>
      </div>
      <div class="install-command">
        <pre><code id="install-command">{installCmd}</code></pre>
        <button class="copy-btn" type="button" data-copy="install-command">Copy</button>
      </div>
      <p class="install-note"><a href={scriptUrl}>Read the install script</a> before running it, or follow the <a href={`${base}/docs/cli/`}>CLI guide</a> for a manual build.</p>
    </section>

    <section class="formats" aria-labelledby="formats-title">
      <div class="section-copy">
        <h2 id="formats-title">Formats</h2>
        <p>Avelune currently defines separate video and audio bitstreams inside an indexed container.</p>
      </div>
      <dl class="format-list">
        <div>
          <dt><a href={`${base}/spec/video/alv1/`}>ALV1</a></dt>
          <dd>Lossy or lossless 8-bit 4:2:0 video.</dd>
        </div>
        <div>
          <dt><a href={`${base}/spec/audio/ala1/`}>ALA1</a></dt>
          <dd>Lossy or lossless audio. The lossy mode is still an experimental research area.</dd>
        </div>
        <div>
          <dt><a href={`${base}/spec/container/avl/`}>AVL</a></dt>
          <dd>A CRC-protected container with a front index and independently addressable epochs.</dd>
        </div>
      </dl>
    </section>

    <section class="streaming" aria-labelledby="streaming-title">
      <div class="section-copy">
        <h2 id="streaming-title">Indexed playback</h2>
        <p>AVL puts the epoch index at the front of the file. A player can read that index first and fetch only the byte ranges needed for playback or seeking.</p>
        <a href={`${base}/docs/browser/streaming-contract/`}>Browser streaming architecture</a>
      </div>
      <ol class="stream-flow" aria-label="Indexed playback sequence">
        <li><strong>Front index</strong><span>stream descriptors and epoch byte ranges</span></li>
        <li><strong>Epoch range</strong><span>the requested part of the file</span></li>
        <li><strong>ALV1 / ALA1</strong><span>video and audio packets</span></li>
        <li><strong>Decoder</strong><span>frames and PCM for presentation</span></li>
      </ol>
    </section>

    <section class="project-state" aria-labelledby="status-title">
      <div class="section-copy">
        <h2 id="status-title">Project status</h2>
        <p>Avelune is a working research implementation, not a production codec. Compression efficiency and performance are behind mature codecs on tested general video, and no compatibility or security-audit guarantee is offered during the 0.x draft phase.</p>
        <a href={`${base}/project/status/`}>Current implementation and limitations</a>
      </div>
      <pre><code>avelune encode input.mkv output.avl
avelune verify output.avl
avelune inspect output.avl</code></pre>
    </section>
  </div>
</BaseLayout>

<script>
  const flash = (button, label) => {
    const previous = button.textContent;
    button.textContent = label;
    setTimeout(() => { button.textContent = previous; }, 1200);
  };

  for (const button of document.querySelectorAll("[data-copy]")) {
    button.addEventListener("click", async () => {
      const target = document.getElementById(button.dataset.copy);
      if (!target) return;
      const text = target.textContent;
      try {
        await navigator.clipboard.writeText(text);
        flash(button, "Copied");
      } catch {
        const textarea = document.createElement("textarea");
        textarea.value = text;
        textarea.style.position = "fixed";
        textarea.style.opacity = "0";
        document.body.appendChild(textarea);
        textarea.select();
        try { flash(button, document.execCommand("copy") ? "Copied" : "Copy failed"); }
        catch { flash(button, "Copy failed"); }
        textarea.remove();
      }
    });
  }
</script>

<style>
  @layer page {
    .home-shell { width: min(calc(100% - 2rem), 1120px); margin-inline: auto; }

    .hero {
      max-width: 850px;
      padding: clamp(5rem, 11vw, 9rem) 0 clamp(4rem, 8vw, 7rem);
    }
    .hero h1 {
      margin: 0;
      font-size: clamp(4rem, 11vw, 8.5rem);
      line-height: .9;
      letter-spacing: -.055em;
    }
    .hero-summary {
      max-width: 700px;
      margin: 1.8rem 0 0;
      color: var(--ink);
      font-size: clamp(1.35rem, 2.8vw, 2rem);
      line-height: 1.35;
    }
    .hero-status {
      max-width: 72ch;
      margin: 1.25rem 0 0;
      color: var(--muted);
      font-size: .95rem;
      line-height: 1.55;
    }
    .hero-actions { display: flex; flex-wrap: wrap; gap: .75rem 1.4rem; align-items: center; margin-top: 2.2rem; }

    .start,
    .install,
    .formats,
    .streaming,
    .project-state {
      padding: clamp(3.5rem, 7vw, 5.5rem) 0;
      border-top: 1px solid var(--rule);
    }

    .start > h2,
    .section-copy h2 { margin: 0; font-size: clamp(1.6rem, 3vw, 2.2rem); }
    .section-copy > p { max-width: 68ch; margin: .7rem 0 0; color: var(--muted); }
    .section-copy > a { display: inline-block; margin-top: 1rem; }

    .start-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      margin-top: 1.5rem;
      border-block: 1px solid var(--rule);
    }
    .start-grid a {
      display: grid;
      gap: .55rem;
      min-width: 0;
      padding: 1.35rem 1.25rem;
      color: var(--ink);
      text-decoration: none;
    }
    .start-grid a + a { border-left: 1px solid var(--rule); }
    .start-grid a:hover strong { color: var(--cool); text-decoration: underline; text-underline-offset: .18em; }
    .start-grid strong { font-size: 1.05rem; font-weight: 500; }
    .start-grid span { color: var(--muted); font-size: .9rem; line-height: 1.5; }

    .install {
      display: grid;
      grid-template-columns: minmax(16rem, .8fr) minmax(0, 1.4fr);
      gap: 1.5rem 4rem;
      align-items: start;
    }
    .install-command { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: .65rem; }
    .install-command pre,
    .project-state pre {
      margin: 0;
      overflow-x: auto;
      padding: 1rem;
      border: 1px solid var(--rule);
      background: var(--surface);
      font: .9rem/1.6 var(--font-mono);
    }
    .install-command code { white-space: nowrap; }
    .copy-btn {
      min-height: 44px;
      padding: .45rem .9rem;
      border: 1px solid var(--control-rule);
      background: transparent;
      color: var(--ink);
      cursor: pointer;
    }
    .copy-btn:hover { border-color: var(--cool); }
    .install-note { grid-column: 2; margin: -.6rem 0 0; color: var(--muted); font-size: .84rem; }

    .formats,
    .streaming,
    .project-state {
      display: grid;
      grid-template-columns: minmax(16rem, .8fr) minmax(0, 1.4fr);
      gap: 4rem;
    }
    .format-list { margin: 0; }
    .format-list div { display: grid; grid-template-columns: 7rem minmax(0, 1fr); gap: 1rem; padding: 1rem 0; border-top: 1px solid var(--rule); }
    .format-list div:last-child { border-bottom: 1px solid var(--rule); }
    .format-list dt { font: 500 1rem var(--font-mono); }
    .format-list dd { margin: 0; color: var(--muted); }

    .stream-flow { margin: 0; padding: 0; list-style: none; counter-reset: flow; }
    .stream-flow li {
      display: grid;
      grid-template-columns: 2rem minmax(9rem, .65fr) minmax(0, 1fr);
      gap: .8rem;
      align-items: baseline;
      padding: .85rem 0;
      border-top: 1px solid var(--rule);
    }
    .stream-flow li:last-child { border-bottom: 1px solid var(--rule); }
    .stream-flow li::before { counter-increment: flow; content: counter(flow); color: var(--muted); font: .78rem var(--font-mono); }
    .stream-flow strong { font-weight: 500; }
    .stream-flow span { color: var(--muted); }

    .project-state pre { align-self: start; }

    @media (max-width: 780px) {
      .hero { padding-top: 4rem; }
      .start-grid { grid-template-columns: 1fr; }
      .start-grid a + a { border-top: 1px solid var(--rule); border-left: 0; }
      .install,
      .formats,
      .streaming,
      .project-state { grid-template-columns: 1fr; gap: 1.5rem; }
      .install-note { grid-column: 1; margin-top: 0; }
    }

    @media (max-width: 480px) {
      .home-shell { width: min(calc(100% - 1.25rem), 1120px); }
      .hero h1 { font-size: clamp(3.6rem, 21vw, 5.4rem); }
      .hero-actions { align-items: stretch; flex-direction: column; }
      .hero-actions a { width: 100%; justify-content: space-between; }
      .install-command { grid-template-columns: 1fr; }
      .copy-btn { width: 100%; }
      .format-list div { grid-template-columns: 1fr; gap: .35rem; }
      .stream-flow li { grid-template-columns: 1.5rem minmax(0, 1fr); }
      .stream-flow span { grid-column: 2; }
    }
  }
</style>
