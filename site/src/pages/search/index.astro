---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadDocuments } from "../../lib/content.mjs";
import { loadRootDocuments } from "../../lib/markdown.mjs";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const allDocuments = [
  ...(await loadDocuments("docs")),
  ...(await loadDocuments("spec")),
  ...loadRootDocuments().map((document) => ({ ...document, route: `/project/${document.slug}/`, type: "project" })),
];
const documents = [
  ...allDocuments.filter((document) => document.type !== "historical"),
  ...allDocuments.filter((document) => document.type === "historical"),
];
---
<BaseLayout title="Search" current="search" description="Search Avelune documentation, specifications, and project information.">
  <div class="index-shell search-shell">
    <header class="index-header">
      <h1>Search</h1>
      <p class="index-summary">Search documentation, specification pages, and project information. Historical material is marked and ranked below current material when both match.</p>
    </header>
    <label for="site-search">Search</label>
    <input id="site-search" type="search" autocomplete="off" placeholder="epoch, quantizer, WebAssembly…" />
    <p id="search-count" class="search-count" role="status">{documents.length} documents indexed</p>
    <ol class="document-list" id="search-results">
      {documents.map((document) => (
        <li
          data-route={document.route}
          data-summary={document.summary}
          data-historical={document.type === "historical" ? "true" : undefined}
        >
          <a href={`${base}${document.route}`}>{document.title}</a>
          <p class="search-snippet">{document.summary}</p>
          <span>{document.type === "historical" ? "Historical" : document.type === "project" ? "Project" : ""}</span>
        </li>
      ))}
    </ol>
  </div>
  <script>
    const input = document.querySelector('#site-search');
    const results = document.querySelector('#search-results');
    const rows = [...document.querySelectorAll('#search-results > li')];
    const count = document.querySelector('#search-count');
    let fullTextState = 'loading';
    let entries = new Map(rows.map((row) => [row.dataset.route, {
      route: row.dataset.route,
      title: row.querySelector('a')?.textContent ?? '',
      summary: row.dataset.summary ?? '',
      body: '',
      historical: row.dataset.historical === 'true',
    }]));

    const normalize = (value) => value.toLocaleLowerCase();
    const scoreEntry = (entry, terms, phrase) => {
      const title = normalize(entry.title);
      const summary = normalize(entry.summary);
      const body = normalize(entry.body);
      const combined = `${title}\n${summary}\n${body}`;
      if (!terms.every((term) => combined.includes(term))) return null;

      let score = 0;
      if (phrase && title === phrase) score += 200;
      else if (phrase && title.includes(phrase)) score += 100;
      for (const term of terms) {
        if (title === term) score += 80;
        else if (title.includes(term)) score += 30;
        if (summary.includes(term)) score += 8;
        if (body.includes(term)) score += 1;
      }
      if (entry.historical) score -= 50;
      return score;
    };

    const excerpt = (entry, terms) => {
      const summary = entry.summary.trim();
      if (!terms.length) return summary;
      if (terms.some((term) => normalize(summary).includes(term))) return summary;
      const body = entry.body.trim();
      if (!body) return summary;
      const normalizedBody = normalize(body);
      const positions = terms.map((term) => normalizedBody.indexOf(term)).filter((position) => position >= 0);
      if (!positions.length) return summary;
      const hit = Math.min(...positions);
      const start = Math.max(0, hit - 90);
      const end = Math.min(body.length, hit + 220);
      let text = body.slice(start, end).trim();
      if (start > 0) text = `…${text.replace(/^\S*\s?/, '')}`;
      if (end < body.length) text = `${text.replace(/\s?\S*$/, '')}…`;
      return text || summary;
    };

    const apply = (updateHistory = true) => {
      const raw = input.value.trim();
      const phrase = normalize(raw);
      const terms = phrase.split(/\s+/).filter(Boolean);

      if (updateHistory) {
        const url = new URL(location.href);
        if (raw) url.searchParams.set('q', raw);
        else url.searchParams.delete('q');
        history.replaceState(null, '', url);
      }

      if (!terms.length) {
        results.hidden = true;
        const suffix = fullTextState === 'loading' ? ' · loading full-text index…' : fullTextState === 'failed' ? ' · title/summary search only' : '';
        count.textContent = `${rows.length} documents indexed${suffix}`;
        return;
      }

      const matches = [];
      for (const row of rows) {
        const entry = entries.get(row.dataset.route);
        const score = entry ? scoreEntry(entry, terms, phrase) : null;
        row.hidden = score === null;
        if (score === null || !entry) continue;
        const snippet = row.querySelector('.search-snippet');
        if (snippet) snippet.textContent = excerpt(entry, terms);
        matches.push({ row, entry, score });
      }

      matches.sort((a, b) =>
        b.score - a.score ||
        Number(a.entry.historical) - Number(b.entry.historical) ||
        a.entry.title.localeCompare(b.entry.title)
      );
      for (const match of matches) results.append(match.row);
      results.hidden = false;

      const historical = matches.filter((match) => match.entry.historical).length;
      const historicalSuffix = historical ? ` · ${historical} historical` : '';
      const indexSuffix = fullTextState === 'loading' ? ' · loading full text…' : fullTextState === 'failed' ? ' · title/summary search only' : '';
      count.textContent = `${matches.length} result${matches.length === 1 ? '' : 's'}${historicalSuffix}${indexSuffix}`;
    };

    input.addEventListener('input', () => apply(true));
    const query = new URLSearchParams(location.search).get('q');
    if (query) input.value = query;
    apply(false);

    const corpusUrl = new URL('corpus.json', location.href).href;
    fetch(corpusUrl).then((response) => {
      if (!response.ok) throw new Error(`search corpus ${response.status}`);
      return response.json();
    }).then((corpus) => {
      for (const entry of corpus) {
        const fallback = entries.get(entry.route);
        entries.set(entry.route, { ...fallback, ...entry });
      }
      fullTextState = 'ready';
      apply(false);
    }).catch(() => {
      fullTextState = 'failed';
      apply(false);
    });
  </script>
</BaseLayout>

<style>
  @layer page {
    .search-shell > label { display:block; margin-top:2.5rem; color:var(--ink); font-size:.85rem; font-weight:500; }
    #site-search { width:100%; min-height:52px; margin-top:.5rem; padding:.65rem .8rem; border:1px solid var(--control-rule); border-radius:1px; background:var(--surface); color:var(--ink); font-size:1rem; }
    .search-count { color:var(--muted); font-size:.8rem; }
    #search-results span:empty { visibility:hidden; }
    #search-results [data-historical="true"] { opacity:.78; }
    .search-snippet { text-wrap:pretty; }
  }
</style>
