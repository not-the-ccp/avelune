---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadDocuments } from "../../lib/content.mjs";
const specs = await loadDocuments("spec");
const current = specs.filter((doc) => doc.type !== "historical");
const history = specs.filter((doc) => doc.type === "historical");
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<BaseLayout title="Draft specification" current="spec">
  <div class="index-shell">
    <header class="index-header"><p class="eyebrow">AUTHORITATIVE SOURCE · DRAFT GENERATION 1</p><h1>Avelune specification</h1><p class="index-summary">Start with the overview and baseline profile, then follow the shared entropy, video, audio, container, and conformance definitions. The checked-in AsciiDoc remains authoritative.</p><p class="index-status">Experimental and unfrozen; incompatible changes remain possible while Avelune is 0.x.</p></header>
    <h2>Current draft</h2>
    <ol class="document-list">{current.map((doc) => <li><a href={`${base}${doc.route}`}>{doc.title}</a><p>{doc.summary}</p><span>{doc.status || doc.type}</span></li>)}</ol>
    {history.length > 0 && <><h2>Historical, non-normative material</h2><ol class="document-list">{history.map((doc) => <li><a href={`${base}${doc.route}`}>{doc.title}</a><p>{doc.summary}</p><span>historical</span></li>)}</ol></>}
  </div>
</BaseLayout>
