---
import BaseLayout from "../../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<BaseLayout title="Browser demo" mode="grid" current="demo">
  <div class="demo-shell">
    <header class="demo-header"><p class="eyebrow">BROWSER PRODUCTION INSTRUMENT</p><h1>Range-fetch and decode Avelune.</h1><p>Custom Draft Generation 1 <code>ALV1</code> video and <code>ALA1</code> audio decoded in WebAssembly by the production Rust container/codec backend, selecting SIMD128 when available; JavaScript only schedules HTTP ranges and presentation.</p></header>
    <div class="instrument">
      <section class="viewport" aria-label="Video viewport"><canvas id="c" width="640" height="360">Decoded Avelune video appears here.</canvas></section>
      <section class="transport" aria-label="Player controls">
        <div class="source-control"><label for="url">Media URL</label><input id="url" type="text" value="demo.avl" spellcheck="false" /><button id="load" type="button">Load stream</button></div>
        <div class="play-control"><button id="play" type="button" disabled>Play / resume</button><label class="sr-only" for="seek">Seek position</label><input id="seek" type="range" min="0" max="1" step=".001" value="0" disabled /><output id="time" for="seek">0.00s</output></div>
        <pre id="status" role="status" aria-live="polite">idle</pre>
      </section>
      <aside class="inspector" aria-label="Stream inspector">
        <header><span>INSPECTOR</span><span id="state-label">IDLE</span></header>
        <section><h2>Format</h2><dl><div><dt>Video</dt><dd id="format-video">—</dd></div><div><dt>Audio</dt><dd id="format-audio">—</dd></div><div><dt>Renderer</dt><dd id="format-renderer">—</dd></div><div><dt>Dimensions</dt><dd id="format-dimensions">—</dd></div></dl></section>
        <section><h2>Container</h2><dl><div><dt>Streams</dt><dd id="container-streams">—</dd></div><div><dt>Epochs</dt><dd id="container-epochs">—</dd></div><div><dt>Front index</dt><dd id="container-front">—</dd></div></dl></section>
        <section><h2>Fetch / playback</h2><dl><div><dt>Epoch</dt><dd id="playback-epoch">—</dd></div><div><dt>Range</dt><dd id="playback-range">—</dd></div><div><dt>Time</dt><dd id="playback-time">0.00s</dd></div></dl></section>
      </aside>
    </div>
  </div>
  <script type="module" src={`${base}/demo/player.js`}></script>
</BaseLayout>
<style>
  @layer page {
    .demo-shell{width:min(calc(100% - 2rem),var(--shell));margin:auto;padding:4rem 0}
    .demo-header{display:grid;grid-template-columns:1fr 2fr;gap:2rem;align-items:start;margin-bottom:2rem}
    .demo-header h1{grid-column:2;margin:0;font-size:clamp(2.5rem,5vw,4.1rem);max-width:15ch}.demo-header>p:last-child{grid-column:2;max-width:65ch;color:var(--muted);margin:0}
    .instrument{display:grid;grid-template-columns:minmax(0,3fr) minmax(240px,1fr);border-block:1px solid var(--rule)}
    .viewport{display:grid;place-items:center;min-height:480px;background:#050505;border-right:1px solid var(--rule)}.viewport canvas{width:100%;height:auto}
    .transport{grid-row:2;display:grid;gap:.75rem;padding:1rem 0;border-top:1px solid var(--rule);border-right:1px solid var(--rule)}
    .source-control,.play-control{display:flex;gap:.65rem;align-items:center;padding-right:1rem}.source-control label{font:.68rem var(--font-mono);color:var(--muted)}
    input,button{min-height:40px;border:1px solid var(--rule);border-radius:2px;background:var(--surface);color:var(--ink)}input[type=text]{min-width:0;flex:1;padding:.45rem .6rem;font-family:var(--font-mono)}button{padding:.4rem .8rem}button:not(:disabled):hover{border-color:var(--cool)}button:disabled{color:var(--muted)}input[type=range]{flex:1;accent-color:var(--cool)}output{min-width:5rem;font: .78rem var(--font-mono)}
    #status{margin:0;padding:.5rem 1rem 0 0;white-space:pre-wrap;color:var(--muted);font-size:.68rem;background:none;border:0}
    .inspector{grid-column:2;grid-row:1/3}.inspector>header{display:flex;justify-content:space-between;padding:.8rem;color:var(--muted);font:.65rem var(--font-mono)}#state-label{color:var(--warm)}.inspector section{padding:.85rem;border-top:1px solid var(--rule)}.inspector h2{margin:0 0 .65rem;color:var(--muted);font:.65rem var(--font-mono);letter-spacing:.08em;text-transform:uppercase}.inspector dl{margin:0}.inspector dl div{display:grid;grid-template-columns:1fr 1fr;gap:.5rem;padding:.25rem 0}.inspector dt{color:var(--muted);font-size:.73rem}.inspector dd{margin:0;text-align:right;font:.7rem var(--font-mono);overflow-wrap:anywhere}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}
    @media(max-width:780px){.demo-header{display:block}.demo-header h1{margin:.6rem 0 1rem}.instrument{display:flex;flex-direction:column}.viewport{min-height:0;border-right:0}.transport{order:2;border-right:0}.inspector{order:3}.source-control{flex-wrap:wrap}.source-control label{width:100%}.source-control input{flex-basis:60%}}
  }
</style>
