---
import BaseLayout from "../../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<BaseLayout
  title="Browser demo"
  description="Play, inspect, seek, and range-fetch Avelune media directly in the browser with the canonical Rust decoder compiled to WebAssembly."
  mode="grid"
  current="demo"
>
  <div class="demo-shell" id="drop-target">
    <header class="demo-header">
      <div>
        <p class="eyebrow">BROWSER CODEC WORKBENCH</p>
        <h1>Play and inspect Avelune.</h1>
      </div>
      <div class="demo-intro">
        <p>
          The canonical Rust codec runs in WebAssembly. Open an existing <code>.avl</code>, or drop ordinary media such as MP4, MKV, WebM, MOV, or Y4M and convert it to Avelune directly in this tab. The resulting file is loaded into the player and can be downloaded immediately.
        </p>
        <p class="fixture-note">
          The tiny 160×90 files remain deterministic regression vectors. Larger procedural showcase clips exercise gameplay-like motion, perspective, hard text edges, audio, seeking, and real browser decode paths without third-party media.
        </p>
      </div>
    </header>

    <div class="instrument">
      <section class="viewport-panel" aria-label="Video output">
        <div class="viewport-head">
          <div>
            <span>OUTPUT</span>
            <strong id="state-label">IDLE</strong>
          </div>
          <p id="state-detail" role="status" aria-live="polite">Preparing the bundled 640×360 showcase…</p>
        </div>

        <div class="viewport">
          <canvas id="c" width="640" height="360">Decoded Avelune video appears here.</canvas>
          <div id="viewport-state" class="viewport-state">Drop a video to convert, open an .avl, or play a bundled showcase.</div>
          <div class="drop-message" aria-hidden="true">DROP .AVL TO OPEN · MEDIA TO CONVERT</div>
        </div>

        <div class="performance-strip" aria-label="Current session measurements">
          <div><span>INDEX LOAD</span><strong id="metric-index">—</strong></div>
          <div><span>RANGE REQUESTS</span><strong id="metric-ranges">0</strong></div>
          <div><span>FETCHED</span><strong id="metric-bytes">0 B</strong></div>
          <div><span>FRAMES SHOWN</span><strong id="metric-frames">0</strong></div>
        </div>
      </section>

      <section class="transport" aria-label="Playback and source controls">
        <div class="play-control">
          <button id="play" class="play-button" type="button" disabled>Play</button>
          <div class="timeline">
            <label class="sr-only" for="seek">Seek position</label>
            <input id="seek" type="range" min="0" max="1" step=".001" value="0" disabled />
            <div class="timeline-meta">
              <output id="time" for="seek">0.00s</output>
              <span>Space · ←/→ 5s · Home/End</span>
            </div>
          </div>
          <label class="compact-label" for="volume">Volume</label>
          <input id="volume" class="volume" type="range" min="0" max="1" step=".01" value="1" />
        </div>

        <section class="source-section media-import" id="media-import">
          <div class="section-heading">
            <span>01</span>
            <div>
              <h2>Open or convert media</h2>
              <p>Drop MP4, MKV, WebM, MOV, AVI, Y4M, or most other FFmpeg-readable video. Conversion stays in this tab and produces a playable, downloadable <code>.avl</code>.</p>
            </div>
          </div>
          <div class="media-file-row">
            <label for="media-file">Media or .avl</label>
            <input id="media-file" type="file" accept=".avl,application/octet-stream,video/*,.mp4,.mkv,.webm,.mov,.avi,.m4v,.ts,.m2ts,.flv,.ogv,.mpg,.mpeg,.y4m" />
            <span id="media-file-name">No file selected.</span>
          </div>
          <div class="media-options">
            <label class="media-field" for="media-video-q"><span>Video quantizer <small>1 = lossless residuals</small></span><input id="media-video-q" type="number" min="1" max="65535" value="112" inputmode="numeric" /></label>
            <label class="media-field" for="media-preset"><span>Preset</span><select id="media-preset"><option value="fast">Fast</option><option value="balanced" selected>Balanced</option><option value="quality">Quality</option></select></label>
            <label class="media-field" for="media-resolution"><span>Resolution</span><select id="media-resolution"><option value="source">Source · even dimensions</option><option value="1920x1080">1920×1080</option><option value="1280x720">1280×720 max canvas</option><option value="854x480">854×480</option><option value="640x360" selected>640×360</option></select></label>
            <label class="media-field" for="media-fps"><span>Frame rate</span><select id="media-fps"><option value="source">Source</option><option value="60">60 fps</option><option value="30" selected>30 fps</option><option value="24">24 fps</option></select></label>
            <label class="media-field" for="media-epoch"><span>Epoch length</span><select id="media-epoch"><option value="1">1 second</option><option value="2" selected>2 seconds</option><option value="4">4 seconds</option><option value="8">8 seconds</option></select></label>
            <label class="media-field" for="media-audio-channels"><span>Audio</span><select id="media-audio-channels"><option value="2" selected>Stereo</option><option value="1">Mono</option><option value="0">Disabled</option></select></label>
            <label class="media-field" for="media-audio-rate"><span>Audio rate</span><select id="media-audio-rate"><option value="48000" selected>48 kHz</option><option value="44100">44.1 kHz</option><option value="32000">32 kHz</option></select></label>
            <label class="media-field" for="media-audio-q"><span>Audio quantizer <small>1 = lossless</small></span><input id="media-audio-q" type="number" min="1" max="65535" value="64" inputmode="numeric" /></label>
            <label class="media-field" for="media-start"><span>Start time <small>seconds</small></span><input id="media-start" type="number" min="0" step="0.1" value="0" inputmode="decimal" /></label>
            <label class="media-field" for="media-duration"><span>Length <small>seconds · 0 = entire file</small></span><input id="media-duration" type="number" min="0" step="0.1" value="0" inputmode="decimal" /></label>
          </div>
          <div class="media-actions">
            <button id="media-convert" type="button" disabled>Convert → Avelune</button>
            <button id="media-cancel" class="secondary-button" type="button" disabled>Cancel</button>
            <progress id="media-progress" max="1" value="0" hidden></progress>
            <span id="media-status" role="status" aria-live="polite">Choose or drop a media file or .avl.</span>
            <a id="media-download" hidden>Download converted .avl</a>
          </div>
          <p class="media-privacy"><strong>Streaming path:</strong> the source file is mounted directly from browser storage, FFmpeg writes raw video/audio into bounded in-process sinks, Avelune emits completed epochs incrementally, and supported browsers spool encoded output through OPFS. Conversion does not upload your media. A compressed-memory fallback is used only when OPFS is unavailable.</p>
          <details class="media-log-panel">
            <summary>Conversion log</summary>
            <pre id="media-log"></pre>
          </details>
        </section>

        <div class="source-section">
          <div class="section-heading">
            <span>02</span>
            <div><h2>Bundled Avelune demos</h2><p>Use these to compare playback immediately; the baseline index loads automatically.</p></div>
          </div>
          <div class="control-row sample-row">
            <label class="sr-only" for="sample">Bundled example</label>
            <select id="sample">
              <option selected value="showcase-2d.avl" data-description="640×360 · 4 s · 30 fps · stereo audio · procedural platform/action showcase">2D gameplay · 640×360 · A/V</option>
              <option value="showcase-3d.avl" data-description="640×360 · 4 s · 30 fps · stereo audio · procedural pseudo-3D racing showcase">3D racing · 640×360 · A/V</option>
              <option value="showcase-text.avl" data-description="640×360 · 4 s · 30 fps · stereo audio · editor/terminal/text/UI showcase">Text / UI · 640×360 · A/V</option>
              <option value="demo.avl" data-description="320×180 · audio + video · 60 video frames · compact baseline browser regression fixture">Compact baseline · 320×180 · A/V</option>
              <option value="motion.avl" data-description="160×90 · 90 frames · procedural motion and texture regression vector; intentionally tiny">Regression: motion · 160×90</option>
              <option value="screen.avl" data-description="160×90 · 90 frames · procedural text and hard-edge regression vector; intentionally tiny">Regression: screen/text · 160×90</option>
            </select>
            <button id="load-sample" type="button">Load fixture</button>
          </div>
          <p id="sample-description" class="source-description"></p>
        </div>

        <div class="source-section">
          <div class="section-heading">
            <span>03</span>
            <div><h2>HTTP Range .avl</h2><p>Stream an Avelune file without downloading it in full. The server must return valid <code>206</code> byte ranges.</p></div>
          </div>
          <div class="control-row source-control-indent">
            <label class="sr-only" for="url">HTTP Range source URL</label>
            <input id="url" type="url" placeholder="https://example.invalid/video.avl" spellcheck="false" />
            <button id="load-url" type="button">Load URL</button>
          </div>
        </div>

        <section class="source-section engine-controls" aria-labelledby="engine-heading">
          <div class="section-heading">
            <span>04</span>
            <div>
              <h2 id="engine-heading">Browser engine</h2>
              <p>These are live controls, not hidden expert settings. Auto prefers SIMD128 and WebGPU when the browser supports them.</p>
            </div>
          </div>
          <div class="engine-status" aria-live="polite">Active codec: <strong id="engine-wasm-active">loading…</strong></div>
          <div class="engine-grid">
            <label for="wasm-artifact">Codec WASM</label>
            <select id="wasm-artifact">
              <option value="auto">Auto · prefer SIMD128</option>
              <option value="simd128">SIMD128</option>
              <option value="scalar">Scalar</option>
            </select>

            <label for="renderer-choice">Video renderer</label>
            <select id="renderer-choice">
              <option value="auto">Auto · prefer WebGPU</option>
              <option value="webgpu">WebGPU</option>
              <option value="canvas">Canvas 2D</option>
            </select>
          </div>
          <p class="engine-note">The inspector shows the artifact and renderer that were actually selected. Imported media uses the same codec-WASM choice for Avelune encoding.</p>
        </section>
      </section>

      <aside class="inspector" aria-label="Stream inspector">
        <header>
          <span>LIVE INSPECTOR</span>
          <span>KNOWN FACTS ONLY</span>
        </header>

        <section>
          <h2>Source</h2>
          <dl>
            <div><dt>Name</dt><dd id="source-name">—</dd></div>
            <div><dt>Size</dt><dd id="source-size">—</dd></div>
            <div><dt>WASM</dt><dd id="wasm-name">—</dd></div>
            <div><dt>Renderer</dt><dd id="format-renderer">—</dd></div>
          </dl>
        </section>

        <section>
          <h2>Streams</h2>
          <pre id="stream-list" class="stream-list">—</pre>
          <dl>
            <div><dt>Video</dt><dd id="format-video">—</dd></div>
            <div><dt>Audio</dt><dd id="format-audio">—</dd></div>
            <div><dt>Dimensions</dt><dd id="format-dimensions">—</dd></div>
          </dl>
        </section>

        <section>
          <h2>Container</h2>
          <dl>
            <div><dt>Streams</dt><dd id="container-streams">—</dd></div>
            <div><dt>Epochs</dt><dd id="container-epochs">—</dd></div>
            <div><dt>Front index</dt><dd id="container-front">—</dd></div>
          </dl>
        </section>

        <section>
          <h2>Playback</h2>
          <dl>
            <div><dt>Duration</dt><dd id="playback-duration">—</dd></div>
            <div><dt>Epoch</dt><dd id="playback-epoch">—</dd></div>
            <div><dt>Frame</dt><dd id="playback-frame">—</dd></div>
            <div><dt>Last range</dt><dd id="playback-range">—</dd></div>
            <div><dt>Time</dt><dd id="playback-time">0.00s</dd></div>
          </dl>
        </section>

        <details class="event-panel">
          <summary>Request / decoder log</summary>
          <pre id="event-log"></pre>
        </details>
      </aside>
    </div>
  </div>
  <script type="module" src={`${base}/demo/player.js`}></script>
</BaseLayout>

<style>
  @layer page {
    .demo-shell {
      width: min(calc(100% - 2rem), var(--shell));
      margin-inline: auto;
      padding: clamp(2.5rem, 6vw, 5rem) 0 5rem;
    }

    .demo-header {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(24rem, 1fr);
      gap: clamp(2rem, 7vw, 6rem);
      align-items: end;
      margin-bottom: 2.5rem;
    }
    .demo-header h1 {
      max-width: 10ch;
      margin: .45rem 0 0;
      font-size: clamp(2.8rem, 6vw, 5.6rem);
      line-height: .96;
      letter-spacing: -.045em;
    }
    .demo-intro {
      align-self: end;
      max-width: 68ch;
    }
    .demo-intro p {
      margin: 0;
      color: var(--muted);
      line-height: 1.55;
    }
    .demo-intro .fixture-note {
      margin-top: .9rem;
      padding-top: .9rem;
      border-top: 1px solid var(--rule);
      font-size: .84rem;
    }

    .instrument {
      display: grid;
      grid-template-columns: minmax(0, 3fr) minmax(270px, 1fr);
      grid-template-areas:
        "viewport inspector"
        "transport inspector";
      border-block: 1px solid var(--rule);
    }

    .viewport-panel {
      grid-area: viewport;
      min-width: 0;
      border-right: 1px solid var(--rule);
    }
    .viewport-head {
      min-height: 52px;
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      align-items: center;
      padding: .65rem 1rem .65rem 0;
      border-bottom: 1px solid var(--rule);
    }
    .viewport-head > div {
      display: flex;
      align-items: baseline;
      gap: .65rem;
      font: .66rem var(--font-mono);
      letter-spacing: .08em;
    }
    .viewport-head span { color: var(--muted); }
    #state-label { color: var(--warm); }
    .viewport-head p {
      max-width: 58ch;
      margin: 0;
      overflow-wrap: anywhere;
      color: var(--muted);
      font-size: .76rem;
      text-align: right;
    }

    .viewport {
      position: relative;
      display: grid;
      place-items: center;
      aspect-ratio: 16 / 9;
      min-height: 360px;
      max-height: 72vh;
      overflow: hidden;
      background: #050505;
    }
    .viewport canvas {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: contain;
      background: #050505;
    }
    .viewport-state {
      position: absolute;
      inset: auto 1rem 1rem;
      max-width: 44rem;
      padding: .65rem .8rem;
      border: 1px solid var(--rule);
      background: rgba(5, 5, 5, .88);
      color: var(--muted);
      font: .7rem/1.45 var(--font-mono);
    }
    .viewport-state[data-state="error"] {
      border-color: var(--warm);
      color: var(--ink);
    }
    .drop-message {
      position: absolute;
      inset: 1rem;
      display: none;
      place-items: center;
      border: 1px dashed var(--cool);
      background: rgba(17, 18, 17, .92);
      color: var(--cool);
      font: .72rem var(--font-mono);
      letter-spacing: .08em;
    }
    .demo-shell[data-drop="true"] .drop-message { display: grid; }

    .performance-strip {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      border-top: 1px solid var(--rule);
    }
    .performance-strip div {
      min-width: 0;
      padding: .65rem .8rem;
      border-right: 1px solid var(--rule);
    }
    .performance-strip div:last-child { border-right: 0; }
    .performance-strip span {
      display: block;
      margin-bottom: .25rem;
      color: var(--muted);
      font: .6rem var(--font-mono);
      letter-spacing: .05em;
    }
    .performance-strip strong {
      display: block;
      overflow-wrap: anywhere;
      font: 500 .78rem var(--font-mono);
    }

    .transport {
      grid-area: transport;
      min-width: 0;
      border-top: 1px solid var(--rule);
      border-right: 1px solid var(--rule);
    }

    .play-control {
      display: grid;
      grid-template-columns: auto minmax(12rem, 1fr) auto minmax(6rem, 8rem);
      gap: .8rem;
      align-items: center;
      padding: 1rem 1rem 1rem 0;
      border-bottom: 1px solid var(--rule);
    }
    .play-button {
      min-width: 7rem;
      min-height: 48px;
      font-weight: 600;
    }
    .timeline { min-width: 0; }
    .timeline-meta {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      margin-top: .35rem;
      color: var(--muted);
      font: .63rem var(--font-mono);
    }
    .timeline-meta output {
      min-width: 4.5rem;
      color: var(--ink);
      font: inherit;
    }
    .compact-label {
      color: var(--muted);
      font: .63rem var(--font-mono);
      letter-spacing: .04em;
      text-transform: uppercase;
    }

    .source-section {
      padding: 1rem 1rem 1rem 0;
      border-bottom: 1px solid var(--rule);
    }
    .source-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }
    .source-grid > div + div {
      padding-left: 1.25rem;
      border-left: 1px solid var(--rule);
    }
    .section-heading {
      display: grid;
      grid-template-columns: 2rem minmax(0, 1fr);
      gap: .5rem;
      margin-bottom: .7rem;
    }
    .section-heading > span {
      color: var(--cool);
      font: .63rem var(--font-mono);
    }
    .section-heading h2 {
      margin: 0;
      font-size: .9rem;
    }
    .section-heading p {
      margin: .15rem 0 0;
      color: var(--muted);
      font-size: .75rem;
      line-height: 1.45;
    }
    .source-description {
      margin: .55rem 0 0 2.5rem;
      color: var(--muted);
      font: .68rem/1.45 var(--font-mono);
    }

    .source-control-indent { margin-left: 2.5rem; }

    .control-row {
      display: flex;
      min-width: 0;
      gap: .5rem;
      align-items: center;
    }
    input, select, button {
      min-height: 42px;
      border: 1px solid var(--control-rule);
      border-radius: 2px;
      background: var(--surface);
      color: var(--ink);
    }
    input[type="url"], input[type="number"], select {
      min-width: 0;
      padding: .45rem .6rem;
      font-family: var(--font-mono);
    }
    input[type="url"], .sample-row select { flex: 1; }
    input[type="file"] {
      width: 100%;
      min-width: 0;
      padding: .35rem;
      font: .72rem var(--font-mono);
    }
    input[type="file"]::file-selector-button {
      min-height: 32px;
      margin-right: .6rem;
      border: 0;
      border-right: 1px solid var(--rule);
      background: transparent;
      color: var(--ink);
    }
    input[type="range"] {
      width: 100%;
      min-height: auto;
      border: 0;
      background: transparent;
      accent-color: var(--cool);
    }
    button {
      padding: .45rem .85rem;
      white-space: nowrap;
      cursor: pointer;
    }
    button:not(:disabled):hover,
    select:hover,
    input:hover { border-color: var(--cool); }
    button:disabled {
      cursor: default;
      color: var(--muted);
    }
    button:focus-visible,
    input:focus-visible,
    select:focus-visible,
    summary:focus-visible {
      outline: 2px solid var(--cool);
      outline-offset: 2px;
    }

    .media-import {
      border-top: 1px solid var(--rule);
    }
    .media-file-row {
      display: grid;
      grid-template-columns: auto minmax(14rem, 1fr) minmax(10rem, .8fr);
      gap: .65rem;
      align-items: center;
      margin: .9rem 0 0 2.5rem;
    }
    .media-file-row > label,
    .engine-grid > label {
      color: var(--muted);
      font: .63rem var(--font-mono);
      text-transform: uppercase;
    }
    #media-file-name {
      overflow-wrap: anywhere;
      color: var(--muted);
      font: .66rem var(--font-mono);
    }
    .media-options {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
      gap: .75rem;
      margin: .9rem 0 0 2.5rem;
    }
    .media-field {
      display: flex;
      min-width: 0;
      flex-direction: column;
      gap: .35rem;
      color: var(--muted);
      font: .63rem var(--font-mono);
      text-transform: uppercase;
    }
    .media-field > span {
      min-height: 2.1em;
      line-height: 1.25;
    }
    .media-field small {
      display: block;
      margin-top: .12rem;
      color: color-mix(in srgb, var(--muted) 72%, transparent);
      font: .58rem/1.2 var(--font-mono);
      text-transform: none;
    }
    .media-field input,
    .media-field select {
      width: 100%;
      max-width: 100%;
    }
    .media-actions {
      display: flex;
      min-width: 0;
      flex-wrap: wrap;
      gap: .65rem;
      align-items: center;
      margin: .9rem 0 0 2.5rem;
    }
    .media-actions progress {
      order: 4;
      width: 100%;
      height: .45rem;
      accent-color: var(--cool);
    }
    #media-status {
      min-width: min(100%, 16rem);
      flex: 1 1 18rem;
    }
    #media-download { flex: 0 1 auto; }
    #media-status { color: var(--muted); font: .68rem/1.45 var(--font-mono); }
    #media-download { color: var(--cool); font: .68rem var(--font-mono); }
    .media-privacy,
    .engine-note {
      margin: .75rem 0 0 2.5rem;
      color: var(--muted);
      font-size: .74rem;
      line-height: 1.5;
    }
    .media-log-panel { margin: .75rem 0 0 2.5rem; }
    .media-log-panel summary,
    .event-panel summary {
      cursor: pointer;
      color: var(--muted);
      font: .68rem var(--font-mono);
    }
    #media-log {
      max-height: 13rem;
      overflow: auto;
      margin: .6rem 0 0;
      padding: .65rem;
      border: 1px solid var(--rule);
      background: #0b0c0b;
      color: var(--muted);
      white-space: pre-wrap;
      font: .61rem/1.45 var(--font-mono);
    }

    .engine-controls {
      border-bottom: 0;
    }
    .engine-status {
      margin: .8rem 0 0 2.5rem;
      color: var(--muted);
      font: .68rem var(--font-mono);
    }
    .engine-status strong { color: var(--cool); font-weight: 600; }
    .engine-grid {
      display: grid;
      grid-template-columns: auto minmax(11rem, 1fr) auto minmax(11rem, 1fr);
      gap: .55rem .8rem;
      align-items: center;
      margin: .8rem 0 0 2.5rem;
    }

    .inspector {
      grid-area: inspector;
      min-width: 0;
    }
    .inspector > header {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      padding: .8rem;
      color: var(--muted);
      font: .61rem var(--font-mono);
      letter-spacing: .06em;
    }
    .inspector section {
