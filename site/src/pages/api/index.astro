---
import BaseLayout from "../../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<BaseLayout title="Rust API" current="api" description="Rust API reference for the Avelune codec and container implementation.">
  <div class="index-shell api-index">
    <header class="index-header">
      <h1>Rust API</h1>
      <p class="index-summary">Generated rustdoc for the application-facing <code>avelune</code> crate. The software API is experimental while Avelune is 0.x.</p>
    </header>

    <section aria-labelledby="api-start">
      <h2 id="api-start">Library reference</h2>
      <p>The crate exposes audio, video, container, session, and threading APIs used by the CLI and other native applications.</p>
      <a class="button-link" href={`${base}/api/rust/avelune/`}>Open rustdoc</a>
    </section>

    <nav class="api-links" aria-label="Related documentation">
      <a href={`${base}/docs/cli/`}><strong>CLI guide</strong><span>Encode, inspect, verify, and decode files.</span></a>
      <a href={`${base}/docs/browser/streaming-contract/`}><strong>Browser integration</strong><span>WASM decoding, media import, and indexed playback.</span></a>
      <a href={`${base}/spec/`}><strong>Format specification</strong><span>Normative Draft Generation 1 bitstream and container definitions.</span></a>
    </nav>
  </div>
</BaseLayout>
<style>@layer page {
  .api-index section { max-width:68ch; margin-top:3rem; }
  .api-index section h2 { margin-bottom:.5rem; }
  .api-index section p { color:var(--muted); }
  .api-links { display:grid; grid-template-columns:repeat(3,1fr); margin-top:4rem; border-block:1px solid var(--rule); }
  .api-links a { display:grid; gap:.35rem; padding:1rem; color:var(--ink); text-decoration:none; }
  .api-links a+a { border-left:1px solid var(--rule); }
  .api-links span { color:var(--muted); font-size:.84rem; }
  @media(max-width:650px){.api-links{grid-template-columns:1fr}.api-links a+a{border-left:0;border-top:1px solid var(--rule)}}
}</style>
