---
import BaseLayout from "../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<BaseLayout title="Page not found">
  <div class="index-shell"><header class="index-header"><p class="eyebrow">HTTP 404</p><h1>That address is outside the index.</h1><p class="index-summary">The requested page does not exist. Continue from the documentation or specification index.</p></header><p><a class="button-link" href={`${base}/docs/`}>Open documentation</a></p></div>
</BaseLayout>
