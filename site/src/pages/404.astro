---
import BaseLayout from "../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<BaseLayout title="Page not found">
  <div class="index-shell">
    <header class="index-header">
      <h1>Page not found</h1>
      <p class="index-summary">There is no page at this address.</p>
    </header>
    <nav class="error-paths" aria-label="Continue browsing">
      <a class="button-link" href={`${base}/docs/`}>Documentation</a>
      <a href={`${base}/spec/`}>Specification</a>
      <a href={`${base}/search/`}>Search</a>
    </nav>
  </div>
</BaseLayout>
<style>@layer page {.error-paths{display:flex;flex-wrap:wrap;gap:1rem 1.5rem;align-items:center;margin-top:2rem}@media(max-width:480px){.error-paths{align-items:stretch;flex-direction:column}}}</style>
