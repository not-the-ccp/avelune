---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { loadDocuments } from "../../lib/content.mjs";

const docs = await loadDocuments("docs");
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const groupDefinitions = [
  {
    id: "use",
    title: "Using Avelune",
    summary: "Install the command-line tools and encode, decode, inspect, or verify media.",
    matches: (sourcePath) => sourcePath.startsWith("docs/user/"),
  },
  {
    id: "browser",
    title: "Browser integration",
    summary: "Byte-range playback, WebAssembly codec APIs, media import, presentation, and browser acceleration.",
    matches: (sourcePath) => sourcePath.startsWith("docs/browser/"),
  },
  {
    id: "architecture",
    title: "Architecture",
    summary: "Non-normative design direction and engineering decisions around the codec.",
    matches: (sourcePath) => sourcePath.startsWith("docs/architecture/"),
  },
  {
    id: "development",
    title: "Development",
    summary: "Conformance, testing, versioning, documentation, and release processes.",
    matches: (sourcePath) => sourcePath.startsWith("docs/development/"),
  },
  {
    id: "history",
    title: "History",
    summary: "Superseded material kept for project history. These documents are not current implementation guidance.",
    matches: (sourcePath) => sourcePath.startsWith("docs/history/"),
  },
];

const assigned = new Set();
const groups = groupDefinitions.map((group) => ({
  ...group,
  documents: docs.filter((doc) => {
    if (!group.matches(doc.sourcePath)) return false;
    assigned.add(doc.sourcePath);
    return true;
  }),
}));
const iprDocument = docs.find((doc) => doc.sourcePath === "docs/IPR-NOTES.adoc");
if (iprDocument) assigned.add(iprDocument.sourcePath);
const unassigned = docs.filter((doc) => !assigned.has(doc.sourcePath));
if (unassigned.length) throw new Error(`Unassigned documentation: ${unassigned.map((doc) => doc.sourcePath).join(", ")}`);
const currentGroups = groups.filter((group) => group.id !== "history");
const historyGroup = groups.find((group) => group.id === "history");

const paths = [
  { title: "Try the browser demo", summary: "Play .avl files or convert ordinary video to Avelune in your browser.", route: "/demo/" },
  { title: "Use the CLI", summary: "Build Avelune and encode, decode, inspect, or verify media.", route: "/docs/cli/" },
  { title: "Read the specification", summary: "Consult the Draft Generation 1 format definitions.", route: "/spec/" },
];

const projectLinks = [
  { title: "Project status", summary: "Implemented scope and known limitations.", route: "/project/status/" },
  { title: "Contributing", summary: "Development workflow and review expectations.", route: "/project/contributing/" },
  { title: "Support", summary: "Information to include when reporting problems.", route: "/project/support/" },
  { title: "Security", summary: "Security posture and vulnerability reporting.", route: "/project/security/" },
];
---
<BaseLayout title="Documentation" current="docs">
  <div class="index-shell docs-index">
    <header class="index-header">
      <h1>Documentation</h1>
      <p class="index-summary">Start with the demo or CLI, then use the browser, architecture, development, and specification documents as needed.</p>
    </header>

    <nav class="docs-paths" aria-labelledby="docs-paths-title">
      <h2 id="docs-paths-title">Start here</h2>
      <ul>
        {paths.map((path) => (
          <li><a href={`${base}${path.route}`}><strong>{path.title}</strong><span>{path.summary}</span></a></li>
        ))}
      </ul>
    </nav>

    <div class="docs-groups">
      {currentGroups.map((group) => group.documents.length > 0 && (
        <section class="docs-group" aria-labelledby={`${group.id}-title`}>
          <header>
            <h2 id={`${group.id}-title`}>{group.title}</h2>
            <p>{group.summary}</p>
          </header>
          <ul class="document-list">
            {group.documents.map((doc) => <li><a href={`${base}${doc.route}`}>{doc.title}</a><p>{doc.summary}</p></li>)}
          </ul>
        </section>
      ))}

      <section class="docs-group" aria-labelledby="project-title">
        <header>
          <h2 id="project-title">Project information</h2>
          <p>Status, contribution, support, security, and intellectual-property information.</p>
        </header>
        <ul class="document-list">
          {projectLinks.map((link) => <li><a href={`${base}${link.route}`}>{link.title}</a><p>{link.summary}</p></li>)}
          {iprDocument && <li><a href={`${base}${iprDocument.route}`}>{iprDocument.title}</a><p>{iprDocument.summary}</p></li>}
        </ul>
      </section>

      {historyGroup && historyGroup.documents.length > 0 && (
        <section class="docs-group history-group" aria-labelledby="history-title">
          <header>
            <h2 id="history-title">{historyGroup.title}</h2>
            <p>{historyGroup.summary}</p>
          </header>
          <ul class="document-list">
            {historyGroup.documents.map((doc) => <li><a href={`${base}${doc.route}`}>{doc.title}</a><p>{doc.summary}</p><span class="history-label">Historical</span></li>)}
          </ul>
        </section>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  @layer page {
    .docs-paths { margin-top: 3rem; }
    .docs-paths h2 { margin: 0 0 1rem; font-size: 1.2rem; }
    .docs-paths ul {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      margin: 0;
      padding: 0;
      border-block: 1px solid var(--rule);
      list-style: none;
    }
    .docs-paths li + li { border-left: 1px solid var(--rule); }
    .docs-paths a {
      display: grid;
      gap: .45rem;
      min-height: 100%;
      padding: 1rem 1.2rem;
      color: var(--ink);
      text-decoration: none;
    }
    .docs-paths a:hover strong { color: var(--cool); text-decoration: underline; text-underline-offset: .18em; }
    .docs-paths strong { font-size: 1rem; font-weight: 500; }
    .docs-paths span { color: var(--muted); font-size: .84rem; line-height: 1.5; }

    .docs-groups { margin-top: clamp(4rem, 8vw, 7rem); }
    .docs-group + .docs-group { margin-top: 4rem; }
    .docs-group > header {
      display: grid;
      grid-template-columns: minmax(10rem, 1fr) 2fr;
      gap: 1.5rem;
      align-items: start;
    }
    .docs-group h2 { margin: 0; font-size: clamp(1.5rem, 3vw, 1.9rem); }
    .docs-group header p { max-width: 62ch; margin: .15rem 0 0; color: var(--muted); }
    .docs-group .document-list { margin-top: 1.5rem; border-top: 1px solid var(--rule); }
    .docs-group .document-list li { grid-template-columns: minmax(11rem, 1fr) 2fr; }
    .docs-group .document-list a { display: flex; align-items: center; min-height: 44px; }
    .history-group .document-list li { grid-template-columns: minmax(11rem, 1fr) 2fr auto; }
    .history-label { align-self: center; color: var(--warm); font: .72rem var(--font-mono); text-transform: uppercase; }

    @media (max-width: 700px) {
      .docs-paths ul { grid-template-columns: 1fr; }
      .docs-paths li + li { border-top: 1px solid var(--rule); border-left: 0; }
      .docs-group > header { grid-template-columns: 1fr; gap: .35rem; }
      .docs-group .document-list li,
      .history-group .document-list li { grid-template-columns: 1fr; }
      .docs-group + .docs-group { margin-top: 3rem; }
    }
  }
</style>
